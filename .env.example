# --- TMDB credentials (one of the two is required) ---
# v3 API key, from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# ...or a v4 read access token (takes precedence if both are set)
TMDB_ACCESS_TOKEN=

# --- Server ---
PORT=8080

# The LAN IP guests will use to reach the Pi. Leave blank to auto-detect the
# first non-internal private IPv4 address. Set it explicitly if the Pi has
# several interfaces (e.g. both Ethernet and Wi-Fi) and detection picks wrong.
HOST_LAN_IP=

# SQLite file. Keep it on the mounted volume so it survives container rebuilds.
DB_PATH=./data/double-feature.db
