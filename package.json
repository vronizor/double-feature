{
  "name": "double-feature",
  "version": "1.0.0",
  "description": "Self-hosted movie-night app: draw random films from curated lists, then pick one by ranked-choice vote.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "fetch-seeds": "node scripts/fetch-seed-lists.mjs",
    "seed": "node scripts/seed.mjs",
    "backfill": "node scripts/backfill.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4"
  }
}
