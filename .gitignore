node_modules/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# Manual backups taken before a migration (e.g. double-feature.db.pre-v2) —
# the patterns above only match names ending in .db, so these need their own.
data/*.db.*
.env
.DS_Store
# Local tool state only — .claude/CLAUDE.md is a shared project convention and
# is deliberately tracked.
.claude/settings.local.json

# Optional local cache for the seed fetchers (WIKI_CACHE_DIR). Never committed:
# a stale page served from here would silently produce a wrong seed file.
.cache/
